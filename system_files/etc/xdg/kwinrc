# Darksham OS: strong window animations by default
[Plugins]
blurEnabled=true
contrastEnabled=true
glideEnabled=true
scaleEnabled=false
magiclampEnabled=true
squashEnabled=false
wobblywindowsEnabled=true
translucencyEnabled=true
shakecursorEnabled=true

[Effect-blur]
BlurStrength=10
NoiseStrength=2

[Effect-translucency]
MoveResize=80

[Effect-wobblywindows]
Drag=85
Stiffness=10
WobblynessLevel=1

[WindowSwitcher]
LayoutName=thumbnail_grid

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
